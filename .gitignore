/target/
**/*.rs.bk
Cargo.lock.orig

# Local run artifacts produced by the headless runner.
/run/
/saves/

# Generated materials. Derived from content/materials/, reproducible by
# construction, and not something to carry in the repository.
/assets/materials/

# C++ reference build output; regenerated by `make -C benchmarks/cpp`.
/benchmarks/cpp/build/

# Python bytecode from running the scripts/ tools.
__pycache__/

# Machine-local state of the coding assistant's tools: plugin databases and the
# worktrees it checks out inside the repository. Neither is project content.
/.claude/data/
/.claude/worktrees/
